import Lax342547.ProjectedPins

namespace Lax342547Proofs.ProjectedPins

open Lax342547.MomentSpace Lax342547.ExactPins Lax342547.ProjectedPins

/--
---
conclusion: Lax342547.ProjectedPins.projected_rank
---
Primal projection cannot increase the dimension of any stored pin space.
Sum this bound over all component/sign spaces of the fixed endpoint.
-/
theorem projected_rank {Comp B H N : Type} [Fintype Comp] [Fintype B] [Fintype H]
    (P : Pin (Comp × Bool) (Fin 2 × (B ⊕ H)) N) (i : Fin 2) :
    (∑ a, Module.finrank Binary (projected P i a)) ≤ P.rank := by
  apply Finset.sum_le_sum
  intro a _
  exact Submodule.finrank_map_le (primalProjection i) (P.space a)

/--
---
conclusion: Lax342547.ProjectedPins.projected_mono
---
Exact pin extension includes the old nominal spaces, and taking the same
endpoint primal projection preserves this inclusion.
-/
theorem projected_mono {Comp B H N : Type}
    (P Q : Pin (Comp × Bool) (Fin 2 × (B ⊕ H)) N) (h : P.Extends Q) (i : Fin 2) :
    ∀ a, projected P i a ≤ projected Q i a := by
  intro a
  exact Submodule.map_mono (h.choose a)

theorem tensorSpace_mono {B : Type} {S T S' T' : Submodule Binary (B → Binary)}
    (hS : S ≤ S') (hT : T ≤ T') : tensorSpace S T ≤ tensorSpace S' T' := by
  apply Submodule.span_mono
  rintro M ⟨v, hv, w, hw, hM⟩
  exact ⟨v, hS hv, w, hT hw, hM⟩

/--
---
conclusion: Lax342547.ProjectedPins.effective_mono
---
Every tensor generated by old projected pins is also generated by the
enlarged ones. Thus every old effective profile, and in particular each
previously stored basis vector, remains in the new effective space.
-/
theorem effective_mono {Comp B H N : Type} (X : Submodule Binary (Comp → Matrix B B Binary))
    (P Q : Pin (Comp × Bool) (Fin 2 × (B ⊕ H)) N) (h : P.Extends Q) (i : Fin 2) :
    effective X P i ≤ effective X Q i := by
  intro x hx e
  exact tensorSpace_mono (Lax342547.ProjectedPins.projected_mono P Q h i (e, true))
    (Lax342547.ProjectedPins.projected_mono P Q h i (e, false)) (hx e)

end Lax342547Proofs.ProjectedPins
